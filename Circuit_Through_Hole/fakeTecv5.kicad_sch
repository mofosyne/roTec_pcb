	(text_box "Vibration Config:\nExternal Notification --> External notification enabled = on\nExternal Notification --> Alert message Vibrate = on\nExternal Notification --> Alert Bell Vibrate = on\nExternal Notification --> Output buzzer (GPIO) = 8\n"
		(exclude_from_sim no)
		(at 302.26 88.9 0)
		(size 62.23 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
