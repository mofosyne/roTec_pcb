		(uuid "aa2a3fd9-5d4b-4f23-9813-87a7cd840364")
	)
	(text_box "R4 = 470\nR5 = 680\n\n# Voltage Division Equation\n# Vadc = Vbatt * (R5 / (R4 + R5))\n\n# Voltage Vbatt --> Vadc ratio\n# ADC_Division = Vadc / Vbatt = (R5 / (R4 + R5))\nR5 / (R4 + R5) = 0.591304347826087\n\n# Voltage Vadc --> Vbatt ratio\n# ADC_Multiplier = Vadc / Vbatt = (R4 + R5) / R5\n(R4 + R5) / R5 = 1.6911764705882353"
		(exclude_from_sim no)
		(at 15.24 19.05 0)
		(size 34.29 17.78)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
